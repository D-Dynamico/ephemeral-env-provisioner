# Application
APP_ENV=development
SECRET_KEY=change-me-in-production

# Auth — REQUIRED. The API refuses to start without it.
# Comma-separated `key:principal` pairs. The principal owns whatever that key
# creates; callers do not choose their own owner. Minimum key length is 16.
# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=k_local_dev_change_me_0123456789:dev@example.com

# Comma-separated browser origins allowed to call the API.
# Empty (the default) sends no CORS headers at all. Never use "*".
CORS_ALLOW_ORIGINS=

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/provisioner

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Docker socket
# Windows (Docker Desktop):
# DOCKER_SOCKET=npipe:////./pipe/docker_engine
# Linux / macOS:
# DOCKER_SOCKET=unix:///var/run/docker.sock

# Environments
DEFAULT_TTL_SECONDS=7200
MAX_ENVIRONMENTS_PER_USER=5
BASE_PORT=20000

# Per-container ceilings for any template role that does not set its own.
# These bound what one environment can consume; the quota above bounds how many
# a principal runs. Raising them raises the worst case by that multiple.
DEFAULT_CONTAINER_MEMORY_LIMIT=512m
DEFAULT_CONTAINER_CPU_LIMIT=1.0
DEFAULT_CONTAINER_PIDS_LIMIT=256
